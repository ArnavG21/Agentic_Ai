# Copy this file to .env and paste your keys after the = signs (no quotes, no spaces).
# On Streamlit Cloud, put the same lines in Settings > Secrets instead, with the values in "quotes".

# Main AI - free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Backup AI and backup web search - free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: makes Jina Reader faster: https://jina.ai/reader
JINA_API_KEY=

# Optional: Google Maps open/closed check (no-card demo key: https://mapsplatform.google.com/maps-demo-key/)
GOOGLE_MAPS_API_KEY=

# Optional, paid: Claude API (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Which AI to try first: gemini, groq or claude
MAIN_AI=groq

# Optional: your email for OpenStreetMap
CONTACT_EMAIL=
